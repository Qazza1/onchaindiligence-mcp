{
  "name": "onchaindiligence-mcp",
  "version": "1.0.0",
  "description": "OnChainDiligence MCP server — agent payment preflight, receipts, and independent settlement verification, plus paid Evidence Provider checks (sanctions, UK/US company) via x402 on Base. Also serves a free, no-auth /public/mcp inspection/verification surface.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "start": "tsx src/local.ts",
    "typecheck": "tsc --noEmit",
    "test:client": "tsx test/client.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check-d27": "tsx scripts/check-d27-schema.mjs",
    "check:d27-readiness": "tsx scripts/check-d27-readiness.mjs",
    "smoke:d27": "tsx scripts/smoke-d27.mjs",
    "operator:build": "esbuild operator/src/main.ts --bundle --format=esm --platform=browser --target=es2020 --outfile=operator/dist/app.js",
    "operator:build:d25a": "esbuild operator/src/d25aMain.ts --bundle --format=esm --platform=browser --target=es2020 --outfile=operator/dist/d25a.js",
    "operator:commerce": "npm run operator:build && npm run operator:build:d25a && tsx operator/server.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.17.1",
    "@coinbase/x402": "^2.1.0",
    "@hono/node-server": "^1.19.14",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@neondatabase/serverless": "^1.1.0",
    "@noble/hashes": "^1.8.0",
    "@onchaindiligence/sdk": "file:../onchaindiligence-sdk",
    "@scure/sr25519": "^2.4.0",
    "@x402/core": "^2.17.0",
    "@x402/evm": "^2.17.0",
    "@x402/extensions": "^2.17.0",
    "@x402/fetch": "^2.17.0",
    "@x402/hono": "^2.17.0",
    "ai": "^5.0.0",
    "dotenv": "^16.6.1",
    "hono": "^4.6.3",
    "viem": "^2.52.2",
    "x402": "^0.5.3",
    "x402-fetch": "^1.2.0",
    "x402-mcp": "^0.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
